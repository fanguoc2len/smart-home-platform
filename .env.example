# Flask runtime
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
ENABLE_NGROK=0
NGROK_AUTHTOKEN=

# Demo access controls. Change these before any real deployment.
ADMIN_REGISTER_PASSWORD=123456
SMART_HOME_PIN=1505

# Face-recognition storage. Keep real data out of Git.
REGISTERED_DB=registered.json
REGISTERED_IMAGES_DIR=registered_images
SAMPLE_IMAGE=
SAMPLE_NAME=Demo User
SAMPLE_CROP=namtran_crop.jpg

# AI model options
MOBILENET_WEIGHTS=imagenet
MOBILENET_WEIGHTS_PATH=
WHISPER_MODEL=small
VOICE_EXECUTE_DEFAULT=0
VOICE_CONTROL_TOKEN=

# Firebase / device bridge
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_COMMAND_URL=
FIREBASE_COMMAND_URL_SANDBOX=
FIREBASE_DEVICES_URL=
FIREBASE_DOORS_BASE=
